rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Doctor profiles collection: contains chamber details, qualifications, BMDC/BHMS credentials
    match /doctor_profiles/{profileId} {
      allow read: if true; // Public chamber directory for clinic info
      allow write: if isAuthenticated() && (
        request.auth.uid == profileId || 
        request.auth.uid == request.resource.data.ownerId || 
        profileId == 'primary-doctor'
      );
    }

    // Patients collection: sensitive clinical and demographic data
    match /patients/{patientId} {
      // Allow reading and writing for authenticated chamber doctors and staff
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && 
        request.resource.data.name is string && 
        request.resource.data.name.size() > 0;
      allow update, delete: if isAuthenticated();
    }

    // Prescriptions collection: clinical diagnoses, vital signs, and prescribed remedies
    match /prescriptions/{prescriptionId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && 
        request.resource.data.patientName is string && 
        request.resource.data.patientName.size() > 0;
      allow update, delete: if isAuthenticated();
    }

    // Custom medicines catalog: clinic-specific potencies, dilutions, and dilutions
    match /custom_medicines/{medicineId} {
      allow read: if true; // Read catalog for prescribing autocomplete
      allow write: if isAuthenticated();
    }
  }
}
